# Template for .env.deploy — copy to .env.deploy and fill in.
# .env.deploy itself is gitignored.
#
# Frontend deploys via Vercel's GitHub integration (no token needed) — every
# push to main on the GitHub remote auto-deploys to prod. Only the backend
# Space push needs credentials.

# Hugging Face account used for both the Space and the model-weights repo.
HF_USER=your-hf-username

# Write-scoped token from huggingface.co/settings/tokens.
# Used to push the Space and to read the private model repo at boot.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Private model repo holding the weights + registry + JSON artefacts.
# Defaults to ${HF_USER}/rtg-tooth-id-weights if unset.
HF_REPO_ID=your-hf-username/rtg-tooth-id-weights

# Pinned commit SHA on the model repo. Bumping this is the only way to ship
# new weights — keeps the Space reproducible across deploys.
# Get with: huggingface-cli repo info ${HF_REPO_ID} --revision main
HF_REVISION=0000000000000000000000000000000000000000
